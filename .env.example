# ============================================================
# CUIR ELITE — environment variables (placeholders only)
# Copy to .env and fill in your real values.
# NEVER commit real credentials.
# ============================================================

# ---- Local PostgreSQL (Drizzle) ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- Supabase (public keys only in the browser) ----
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---- Supabase (SERVER ONLY — never expose to the client) ----
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---- Optional: Google Sheets order sync ----
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
